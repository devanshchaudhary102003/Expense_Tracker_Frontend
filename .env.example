# SpendSmart frontend environment variables
# Copy this file to .env (or .env.local) and adjust as needed.

# Base URL for the SpendSmart API Gateway (YARP).
# All regular app API calls go through here.
# Default: http://localhost:5201
VITE_API_BASE_URL=http://localhost:5201

# Base URL for AuthService (used DIRECTLY for Google OAuth only).
# OAuth bypasses the gateway because the Google callback URL must land
# back on the AuthService host where Cookie auth is configured.
# Default: http://localhost:5039
VITE_AUTH_BASE_URL=http://localhost:5039
